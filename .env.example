# ============================================================================
# Mandipulse environment template
# Copy values into packages/backend/.env and/or packages/frontend/.env as noted.
# ============================================================================

# --- Database (backend: packages/backend/.env) ------------------------------
# Postgres connection string. Local dev default matches docker-compose.yml.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/mandipulse?schema=public"

# --- Backend (packages/backend/.env) ----------------------------------------

# HTTP port for the Fastify API server.
PORT=3000

# Fastify log level (fatal|error|warn|info|debug|trace).
LOG_LEVEL=info

# Comma-separated allowlist of browser origins allowed by CORS,
# e.g. "https://mandipulse.example.com,https://staging.example.com".
# Leave UNSET in local development (any origin allowed). SET in production.
FRONTEND_ORIGIN=

# Watchdog cron that periodically scrapes all active collectors via Bright Data
# and auto-detects incidents. OFF by default; set to "true" ONLY on a machine
# where you accept automatic Bright Data credit usage every interval.
WATCHDOG_ENABLED=false

# Simulate-drift live-CLI opt-in. When "true" AND a Bright Data token is set,
# POST /api/simulate-drift attempts one real (15s timeout) heal call before
# falling back to the captured replay. Default false = replay only, no credits.
SIMULATE_USE_REAL_CLI=false

# BRIGHTDATA_API_TOKEN — OPTIONAL — leave unset in production deployments to
# prevent automatic credit usage from the watchdog cron; simulate-drift works
# fully without it (it replays the captured genuine-heal-mumbai artifact).
# (cli.ts also accepts BRIGHTDATA_API_KEY as an alias.)

# --- Frontend (packages/frontend/.env) ---------------------------------------

# Base URL of the backend API the browser should call, e.g.
# "https://api.mandipulse.example.com". Leave UNSET in local dev — relative
# /api paths then go through the Vite dev proxy to localhost:3000.
VITE_API_URL=
