{
  "name": "mandipulse",
  "version": "0.1.0",
  "private": true,
  "description": "Mandipulse monorepo - scraping platform powered by Bright Data",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --parallel -r --stream dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "format": "pnpm -r format",
    "format:check": "pnpm -r format:check",
    "typecheck": "pnpm -r typecheck",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:migrate": "pnpm --filter @mandipulse/backend db:migrate",
    "db:seed": "pnpm --filter @mandipulse/backend db:seed"
  }
}